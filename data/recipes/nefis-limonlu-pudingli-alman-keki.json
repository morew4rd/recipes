 "ingredients": [
  "3 yumurta",
  "1 su bardağından bir parmak eksik şeker",
  "1 su bardağından bir parmak eksik süt",
  "1 su bardağından bir parmak eksik sıvı yağ",
  "1 paket vanilya",
  "Çay kaşığının ucuyla tuz",
  "2 su bardağı un",
  "1 paket kabartma tozu",
  "1 çay bardağı şeker",
  "1 yumurta",
  "2 limonun suyu",
  "1 limonun rendelenmiş kabuğu",
  "2,5 su bardağı süt",
  "2,5 yemek kaşığı nişasta"
 ],
 "instructions": [
  "Şeker ve yumurtayı çırpıyoruz süt, sıvı yağ, vanilya,tuz,ilave ederek çırpmaya devam ediyoruz un ve kabartma tozunu ilave ederek kekimizi hazırlıyoruz.",
  "Yağlı kağıt serdiğimiz büyük borcama kekimizin yarısını dökerek önceden ısıttığımız fırında üzeri kızarana kadar 180 derecede pişiriyoruz.",
  "Bu arada pudingi hazırlıyoruz yumurta ve şekeri çırpıyoruz nişasta, limon suyu ve rendesi ve sütü ilave ederek orta ateşte karıştırarak pişiriyoruz.",
  "Pişen kekin üzerine pudingi yayıyoruz.",
  "Üzerine kekin kalan yarısını döküp tekrar fırına veriyoruz.",
  "Üzeri kızarınca fırından çıkarıyoruz (soğuyunca istenirse üzerine pudra şekeri eleyebiliriz)."
 ],
