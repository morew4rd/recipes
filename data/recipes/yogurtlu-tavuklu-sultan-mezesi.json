 "ingredients": [
  "700-800 gram tavuk göğüs eti",
  "2 diş sarımsak",
  "1,5- 2 kg katı yoğurt",
  "1 su bardağı kadar irice kıyılmış ceviz",
  "6-7 kornişon ( taze salatalık ta olur)",
  "Dereotu",
  "2-3 kaşık zeytinyağı",
  "2-3 kaşık mayonez",
  "Tuz, karabiber"
 ],
 "instructions": [
  "Önce tavuk göğüs etini kaynatıyoruz.",
  "Kaynayan tavuk etlerini küçük doğruyoruz.",
  "Suyunu çorbada kullanmak üzere ayırıyoruz.",
  "Turşuları veya salatalıkları küçük doğruyoruz.",
  "Sarımsağı tuzla ezip yoğurtla karıştırıyoruz.",
  "Tüm malzemeleri karıştırıyoruz.Nefis mezemiz servise hazır."
 ],
