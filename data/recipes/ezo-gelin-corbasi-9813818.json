 "ingredients": [
  "2 su bardağı etsuyu veya tavuk suyu",
  "1 kahve fincanı kırmızı mercimek",
  "1 kahve fincanı bulgur",
  "1 kahve fincanı pirinç",
  "1 yemek kaşığı tepeleme un",
  "1 kaşık domates salçası",
  "1 kaşık biber salçası",
  "1 tatlı kaşığı nane",
  "1 çay kaşığı karabiber",
  "1 çay kaşığı kırmızı toz biber",
  "İstenirse pul biber",
  "1 fincan kadar zeytinyağı (İstenirse + 1 kaşık tereyağı)"
 ],
 "instructions": [
  "Zeytinyağını tenceremize alıyoruz.",
  "Un ilave ederek hafif kokusu çıkana kadar kavuruyoruz.",
  "Yıkadığımız mercimek, bulgur ve pirinçleri ilave ediyoruz.",
  "İki- üç dakika çevirip salçaları ilave ediyoruz.",
  "Biraz karıştırıp soğuk et suyunu ilave ederek karıştırıyoruz.",
  "Kıvamını ayarlayarak su ilave ederek kaynamaya bırakıyoruz.",
  "Malzemeler pişince gerekirse kıvamı için sıcak su ilave ediyoruz.",
  "Tavada kırmızı biberli, naneli yağ hazırlayarak tenceremize ( isteyen kaselere) koyup karıştırıyoruz.",
  "Tuzunu ve karabiberini ilave ediyoruz. ( ben önceden dondurucuda hazırladığım kemikli et suyunu kullandım. Çorbanın içinde eridi) Nefis sağlıklı çorbamız hazır. Afiyet olsun 😊."
 ],
