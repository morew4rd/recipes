 "ingredients": [
  "20 kg kırmızı kapya biber",
  "3 kg patlıcan",
  "1,5 kg havuç",
  "5 kg domates",
  "Yarım kg acı biber( isteğe bağlı)",
  "3 kg soğan",
  "500 gram sarımsak",
  "3 demet nane veya maydanoz ( her ikisi de olabilir)",
  "Tuz, karabiber",
  "3 su bardağı sıvı yağ"
 ],
 "instructions": [
  "Tencerenin altına 2-3 mm kalınlığında saç koyuyoruz. Ateş direk etki edip dip tutmasını engellemek için.",
  "Bütün malzemelerimizi yıkayıp hazırlıyoruz. (patlıcan ve biberleri isteğe bağlı közleyebiliriz, havuçları haşlayabiliriz).",
  "Domatesleri, soğanları, havuçları doğruyoruz.Tenceremize yerleştiriyoruz.",
  "Kabuklarını soyduğumuz patlıcanları, naneleri, sarımsakları, acı ve kapya biberleri de ilave ederek kaynamaya alıyoruz.",
  "Sık sık karıştırıyoruz.",
  "Malzemeler yumuşayıp azaldıkça kalan malzemeleri de tencereye ilave ediyoruz.",
  "Malzemeler yumuşayınca ocağı kapatıp soğumasını bekliyoruz.",
  "Tenceremize 3 bardak yağ alıyoruz.",
  "Malzememizi önce robottan geçirip, sonra da makarna süzgüsünden geçirerek tekrar kaynamaya alıyoruz. ( süzgünün üzerine kalanları sofra bezinin üzerinde kurutarak önce rondodan, sonra da makarna süzgüsünden eleyerek sebzeli çeşni elde ettim😊herşeyi değerlendirmeye çalıştım).",
  "Karıştırırken patladığı için dikkat ediyoruz.",
  "Ekmeğe sürülme kıvamına gelince baharatları ve tuzu ilave ediyoruz.",
  "Sıcak sıcak kavanozlara doldurup havasını alıp ters çevirip üzerlerini örtüyoruz.",
  "Soğuduğu zaman dolaba kaldırıyoruz."
 ],
