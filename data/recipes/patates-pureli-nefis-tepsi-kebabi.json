 "ingredients": [
  "1 kg kıyma",
  "2 adet soğan",
  "Yarım demet maydanoz",
  "1-2 diş sarımsak",
  "1 yumurta",
  "3-4 kaşık galeta unu veya 2 dilim ekmek içi",
  "Tuz",
  "Karabiber",
  "Pulbiber",
  "Kimyon",
  "2 yemek kaşığı domates salçası",
  "1 su bardağı sıcak su",
  "5-6 tane patates",
  "1,5 su bardağı süt (bardak ölçüsü 200 mg)",
  "Tuz",
  "Karabiber",
  "1 su bardağı rendelenmiş kaşar peyniri",
  "2 yemek kaşığı tereyağı",
  "Domates",
  "Biber"
 ],
 "instructions": [
  "Kebabımızın önce köftesini hazırlıyoruz. Önce soğan, maydanoz, yumurta, sarımsak, tuz ve baharatları rondodan geçiriyoruz.",
  "Sos kıvamına gelince karıştıracağımız kaba; kıyma, ekmek içi (veya galeta ununu) ve soğanlı sosu karıştırarak iyice yoğuruyoruz.",
  "Hafif yağlanmış fırın kabına köfte harcını elimizle hafif bastırarak yayıyoruz.",
  "Bir kasede salça ve sıcak suyu karıştırarak kıymanın üzerine kaşıkla yayıyoruz.",
  "Isıtılmış fırında 180 derecede üzeri kızarana kadar 30 dakika kadar pişiriyoruz.",
  "Bu arada patates püresini hazırlıyoruz; yıkadığımız patateslerin kabuklarını soyuyoruz, küp küp doğruyoruz. Üzerini biraz geçecek kadar su koyarak haşlıyoruz.",
  "Pişen patateslerin suyunu süzüyoruz. Üzerine tereyağı, tuz, karabiber ekleyerek patates eziciyle eziyoruz.",
  "Bir yandan sütü yavaş yavaş ekliyoruz. Püre kıvamına gelince kaşar rendesini ekliyoruz.",
  "Köftenin üzerine püreyi yayıyoruz.",
  "Uzun doğradığımız biberleri üzerine diziyoruz.",
  "Aralarına domates halkalarını diziyoruz.",
  "Domatesler pişene kadar 30 dakika daha fırında pişiriyoruz.",
  "Fırından alarak dilimliyoruz ve; nefis kebabımız servise hazır. Afiyet olsun 😊"
 ],
