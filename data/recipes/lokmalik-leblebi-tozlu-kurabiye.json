 "ingredients": [
  "2 su bardağı leblebi tozu (bardak ölçüsü 200 mg)",
  "1 su bardağı zeytinyağı",
  "1 su bardağı pudra şekeri",
  "1- 2 yemek kaşığı susam( isteğe bağlı)",
  "İsteğe bağlı 2 yemek kaşığı tahin",
  "1 su bardağı nişasta",
  "Alabildiği kadar un",
  "2 kaşık kakao (isteğe bağlı)",
  "Yarısını kakaolu yaptım"
 ],
 "instructions": [
  "Bütün malzemeleri karıştırıyoruz (kakao hariç).",
  "Yarısını ayırıp kakao ilave ediyoruz.",
  "Lokmalık parçalar kopararak yuvarlıyoruz.",
  "Fırın kağıdı koyduğumuz tepsiye kurabiyeleri sıralıyoruz.",
  "175 derece ısıtılmış fırında 20 dakika pişiriyoruz ( üzeri hafif kızarıncaya kadar pişiriyoruz).",
  "Tepside soğumasını bekliyoruz."
 ],
