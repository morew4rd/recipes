 "ingredients": [
  "3 tane büyük havuç",
  "2-3 diş sarımsak",
  "1-2 bardak etsuyu veya tavuksuyu",
  "1 çay bardağı tel şehriye",
  "1 kahve fincanı zeytinyağı",
  "3 bardak sıcak su",
  "1 su bardağı yoğurt",
  "1 yumurta sarısı",
  "3 kaşık un",
  "Yarım çay kaşığı karabiber",
  "1 kaşık tereyağı",
  "1 kaşık zeytinyağı",
  "1 tatlı kaşığı kadar nane",
  "İsteğe bağlı pulbiber",
  "Yarım çay kaşığı tuz"
 ],
 "instructions": [
  "Önce havuçları yıkayıp, rendenin ince tarafıyla rendeliyoruz.",
  "Sarımsakları eziyoruz.",
  "Tencereye sıvı yağı alarak ocağı açıyoruz.",
  "Havuç ve sarımsakları kısık ocakta iyice kavuruyoruz.",
  "Şehriyeleri ilave ederek birkaç dakika daha kavurmaya devam ediyoruz.",
  "Sıcak su, ve etsuyunu ilave ederek pişmeye bırakıyoruz.",
  "Bu arada terbiyesini hazırlıyoruz.",
  "Yumurta sarısı, yoğurt ve unu homojen olana kadar çırpıyoruz.",
  "Şehriyesi pişen çorbamızdan birkaç kepçe alıp azar azar terbiyeyle karıştırıyoruz.",
  "Hızlıca çorbaya ilave ederek karıştırıyoruz.",
  "Kaynayınca kıvamını ayarlıyoruz.",
  "Gerekirse su ilave ediyoruz.",
  "Tuzunu ve yarım çay kaşığı kadar karabiber ilave ediyoruz.",
  "Üzeri için tereyağı ve zeytinyağını ısıtıyoruz.",
  "Naneyi ve çok az tuz ilave ederek ocağı kapatıyoruz.",
  "İster tencereye, istersek te kaselere çorbanın üzerine naneli yağı kaşıkla gezdiriyoruz.Nefis, şifa deposu çorbamız servise hazır. Afiyet olsun 😊."
 ],
