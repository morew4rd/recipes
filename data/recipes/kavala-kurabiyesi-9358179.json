 "ingredients": [
  "250 gram margarin ve tereyağı karışımı",
  "1 çay bardağı zeytinyağı",
  "1-1,5 bardak çiğ badem (veya fındık)",
  "1 bardak pudra şekeri",
  "1/2 (yarım) paket kabartma tozu",
  "Alabildiği kadar un",
  "1 bardağa yakın pudra şekeri"
 ],
 "instructions": [
  "Önce bademlerimiz irice kıyıp kavuruyoruz.",
  "5-6 dakika sonra 1 bardak un ilave ederek un kokusu gideseye 5-6 dakika kadar daha kavuruyoruz ve soğumaya bırakıyoruz.",
  "Tereyağı, margarin, zeytinyağı, 1 bardak pudra şekerini karıştırıyoruz.",
  "Bademli unu ve kabartma tozunu da ilave ediyoruz.",
  "Alabildiği kadar un ilavesiyle hamuru hazırlıyoruz.",
  "Büyükçe bezeler yapıyoruz.",
  "1 cm kadar kalınlıkta açıyoruz.",
  "Varsa kalıpla, yoksa su veya çay bardağıyla yarım ay şekli veriyoruz.",
  "175 derece fırında kontrollü olarak 35 -40 dakika kadar pişiriyoruz.",
  "Soğuduktan sonra üzerine süt süzgüsüyle pudra şekeri eliyoruz.",
  "Nefis kurabiyelerimiz hazır."
 ],
