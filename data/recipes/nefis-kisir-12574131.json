 "ingredients": [
  "3 su bardağı ince bulgur (200 mg)",
  "2 su bardağına yakın sıcak su",
  "1 adet büyük soğan",
  "5-6 marul yaprağı",
  "8-10 taze soğanın yeşil kısmı",
  "1 demet maydanoz",
  "2-3 adet kornişon turşu (varsa)",
  "1 su bardağına yakın zeytinyağı",
  "1 yemek kaşığı domates salçası",
  "1 yemek kaşığı biber salçası",
  "1 tatlı kaşığı toz kırmızı biber (isteğe göre acı tozbiber)",
  "Tuz",
  "Karabiber"
 ],
 "instructions": [
  "Bulgura sıcak suyu ilave edip, karıştırıp, üzerini kapatıyoruz.",
  "Bu arada ince ince doğradığımız soğanı kısık ateşte zeytinyağında kavuruyoruz.",
  "Kavrulunca salçaları ve toz kırmızı biberi ilave edip bulgura ilave ederek karıştırıyoruz.",
  "Taze sağan, marul ve maydanozu ince ince doğrayıp ilave ediyoruz. Varsa kornişonları doğrayıp, ilave ediyoruz.",
  "Tuzunu, karabiberini ayarlayıp karıştırıyoruz. Nefis kısırımız servise hazır afiyet olsun 😊"
 ],
