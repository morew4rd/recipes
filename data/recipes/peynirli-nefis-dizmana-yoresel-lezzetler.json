 "title": "Peynirli Nefis Dızmana (Yöresel Lezzetler)",
 "author": "sevim girgin",
 "datePublished": "2022-12-25",
 "categories": [
  "Hamur İşi Tarifleri"
 ],
 "servings": "10-12 kişilik",
 "times": {
  "prep": "PT1H30M",
  "cook": "PT45M",
  "total": "PT105M"
 },
 "ingredients": [
  "1 su bardağı süt",
  "1su bardağı su",
  "1 paket maya",
  "1 yumurtanın beyazı (Sarısı üzerine)",
  "1 tatlı kaşığı şeker",
  "1 tatlı kaşığı tuz",
  "Alabildiği kadar un (5 su bardağı civarında)",
  "1 kase peynir veya lor (Ben karışık kullandım)",
  "1 çay kaşığı kadar çörek otu",
  "1 tutam kıyılmış maydanoz",
  "İstenirse pulbiber",
  "1 su bardağı yoğurt",
  "1 çay bardağı zeytinyağı",
  "1 yumurta sarısı",
  "1 kahve fincanı süt",
  "Tuz"
 ],
 "instructions": [
  "Önce ılık su ve süte maya ve şekeri koyup karıştırıyoruz.",
  "Tuz, yumurta beyazı ve unu ekleyerek hamurumuzu yoğuruyoruz.",
  "İyice yoğurduğumuz hamurumuzun üzerini örterek bir saat kadar mayalanmaya bırakıyoruz.",
  "Bu arada iç malzemesini hazırlıyoruz.",
  "Mayalanan hamuru üç bezeye ayırıp yuvarlıyoruz.",
  "Hamuru oklava veya merdane ile uzunlamasına açıyoruz (Dikdörtgen şekline yakın).",
  "İçine peynir koyarak rulo şekline getiriyoruz.",
  "İstediğimiz genişlikte (Ben üç parmak kadar büyüklükte kestim) keserek yağlı tepsiye biraz aralıklı diziyoruz.",
  "Diğer bezelere de aynı işlemi uyguluyoruz.",
  "15 dakika kadar tepsi mayası için bekletiyoruz.",
  "Bu arada üzerinin sosunu hazırlıyoruz.",
  "1 su bardağı yoğurt, bir çay bardağı zeytinyağı, yarım fincan süt, yumurta sarısı ve tuzu karıştırıyoruz.",
  "Tepsi mayası olunca kaşıkla üzerlerine sos döküyoruz.",
  "Kalan sosu üzerlerine dökerek bitiriyoruz.",
  "190derece önceden ısıtılmış fırında üzerleri kızarıncaya kadar pişiriyoruz.",
  "8-9 dakika dinlenen mis kokulu dızmanamız hazır. Kahvaltılarda, ara öğünlerde nefis bir lezzet. Afiyet olsun 😊."
 ],
