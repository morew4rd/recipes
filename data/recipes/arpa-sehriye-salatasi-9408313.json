 "ingredients": [
  "Bir parça tavuk göğüs eti",
  "1 havuç",
  "1 bardak arpa şehriye",
  "Yarım fincan zeytinyağı",
  "5-6 közlenmiş kapya kırmızı biber",
  "6-7 kornişon",
  "Maydanoz veya dereotu",
  "2-3 diş sarımsak",
  "Yarım kg katı yoğurt"
 ],
 "instructions": [
  "Önce tavuğumuzu haşlayalım, kaynayan tavukları didikleyelim.",
  "Yarım fincan zeytinyağında rendelenmiş havuçları kavuruyoruz.",
  "Arpa şehriyeleri de ilave edip biraz daha kavuruyoruz.",
  "Tavuk etlerini ve 2 bardak sıcak tavuk suyunu( veya normal su) ilave edilip pişiriyoruz.",
  "Pişince tuz ve karabiber ilave edilip demlendiriyoruz.",
  "Köz biberleri, kornişon turşuları, maydanozları doğruyoruz.",
  "Sarımsakları tuzla ezip yoğurtla karıştırıyoruz.",
  "Soğuyan şehriyemizle bütün malzemeleri karıştırıp tuzunu ayarlıyoruz."
 ],
