 "ingredients": [
  "1 kg çıtır salatalık",
  "6-7 diş sarımsak",
  "2 çay bardağı sirke",
  "2 yemek kaşığı kaya tuzu",
  "2 tatlı kaşığı şeker",
  "2 tatlı kaşığı limon tuzu",
  "Sıcak su"
 ],
 "instructions": [
  "1 kg salatalıktan 2 adet 1 lt lik turşu oldu (malzemeleri istediğimiz kadar çoğaltabiliriz).",
  "Önce turşu malzemelerini iyice yıkıyoruz.",
  "Ben sadece salatalık kullandım ( havuç, biber vs kullanılabilir).",
  "Bir lt lik kavanoza 1 yemek kaşığı kaya tuzu, 1 tatlı kaşığı şeker, 1 tatlı kaşığı limon tuzu koyuyoruz.",
  "Üzerine 1 çay bardağı sirke ilave ediyoruz.",
  "Salatalıklarımızı istediğimiz büyüklükte doğruyoruz ( bütün yapacaksak iki ucundan kesiyoruz).",
  "Suyu kaynatıyoruz.",
  "Alabildiği kadar suyu kavanoza ilave ederek kapağını sıkıca kapatıyoruz.",
  "Ters çevirerek üzerini örtüyoruz.",
  "Sonraki 5-6 gün serin bir yerde bekletiyoruz."
 ],
