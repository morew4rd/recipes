 "categories": [
  "Tatlı Tarifleri",
  "Çikolatalı Tarifler"
 ],
 "servings": "8-10 kişilik",
 "times": {
  "prep": "PT5M",
  "cook": "PT15M",
  "total": "PT20M"
 },
 "ingredients": [
  "1 lt süt",
  "1,5 su bardağı şeker ( bardak ölçüsü 200 mg)",
  "Tepeleme 3 yemek kaşığı nişasta",
  "Tepeleme 2 yemek kaşığı un",
  "Tepeleme 3 yemek kaşığı kakao",
  "1 yemek kaşığı tereyağı",
  "100 gram bitter çikolata",
  "1 çay kaşığı vanilya"
 ],
 "instructions": [
  "Orta ateşte süt, şeker, nişasta, un ve kakaoyu karıştırarak pişirmeye başlıyoruz.",
  "Kıvam alıp kaynamaya başladıktan sonra tereyağı, vanilya ve çikolatayı ilave edip birkaç dakika daha pişiriyoruz.",
  "Biraz ılınınca blenderden geçirip saklama kabına döküyoruz.",
  "Oda sıcaklığına gelince buzdolabının dondurucu bölümüne kaldırıyoruz.",
  "5-6 saat sonra çıkarıp 3-5 dakika bekleyip ( kolay kesilebilmesi için) istediğimiz boyutlarda kesiyoruz.",
  "İstersek dondurma çubuğu takarak, ya da tabakta kaşık ile yiyoruz afiyet olsun 😊 mutlaka deneyin."
 ],
