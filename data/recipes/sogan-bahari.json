 "ingredients": [
  "3-4 soğan (Yarım ay şeklinde çok ince doğranmış)",
  "2 şişe sade maden suyu (Soğuk olacak)",
  "2.5 bardak un",
  "Tuz",
  "1 paket hamur kabartma tozu",
  "Yarım çay kaşığı pulbiber",
  "Yarım çay kaşığı karabiber",
  "2 bardak kadar zeytinyağı"
 ],
 "instructions": [
  "Soğanları yarım ay şeklinde ince doğruyoruz.",
  "Kabartma tozu, tuz, karabiber ve pulbiber derin bir kaseye alıyoruz.",
  "Soğuk sodayı döküyoruz.",
  "İçine unu koyup, homojen olacak şekilde karıştırıyoruz.",
  "Soğanları ilave ederek karıştırıyoruz.",
  "Tavaya yağı alıp, yağı ısıtıyoruz.",
  "İyice ısınan yağa kaşık ile mücver gibi koyuyoruz.",
  "Kızarınca diğer tarafına çevirerek diğer tarafını da kızartıyoruz.",
  "Fazla yağını alması için peçeteye çıkarıyoruz.",
  "Malzeme bitene kadar devam ediyoruz. Nefis bir tat. Denemenizi öneririm. Afiyet olsun 😊"
