 "ingredients": [
  "750-800 gram tavuk eti",
  "6-7 iri soğan",
  "2 çiğ patates",
  "1 kg hazır yufka",
  "1 su bardağı süt",
  "1 su bardağı zeytin yağı",
  "Tuz, karabiber, istenirse pulbiber"
 ],
 "instructions": [
  "Önce soğanları rondodan geçiriyoruz.",
  "Soğanları tenceremize alıyoruz.",
  "Üzerine tavukları koyarak ocağa alıyoruz.Tavuklar soğanın içinde pişecek.",
  "Kısık ateşte tavuklar pişene kadar pişiriyoruz.",
  "Ocağı kapatıyoruz.",
  "Tavuk parçalarını çıkararak biraz soğumasını bekliyoruz.",
  "Bu arada rendelediğimiz patateslerin suyunu sıkarak soğanlara ilave ediyoruz.",
  "Tencerenin kapağını kapatıyoruz.",
  "Tavuk etlerini (kemikli kullandıysak kemiklerini ayıklıyoruz) küçük doğruyoruz.",
  "Tuz, karabiber ilave ederek soğanlı, patatesli harcımızla karıştırıyoruz.",
  "Yağlı kağıt serdiğimiz tepsiye ilk yufkayı seriyoruz.",
  "Üzerine malzememizden her yerine eşit dağıtıyoruz.",
  "Yağ ve sütü çırparak 3-4 kaşık gezdiriyoruz.",
  "2. Yufkayı da üzerine sererek tavuklu malzememizi ve sütlü karışımımızı ilave ediyoruz.",
  "Bütün yufkalara aynı işlemi tekrarlıyoruz.",
  "Son yufkamızın.Üzerine kalan yağlı sütü sürerek fırına koyuyoruz.",
  "180 derecede kontrollü olarak üzeri kızarana kadar pişiriyoruz.Piştikten sonra istediğimiz zaman servis yapıyoruz.Afiyet olsun 🙂."
 ],
