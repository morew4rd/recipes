 "ingredients": [
  "1 su bardağı süt (200 mg)",
  "Yarım su bardağı su",
  "1 çay bardağı sıvı yağ",
  "1 paket maya",
  "1 tatlı kaşığı şeker",
  "Yarım tatlı kaşığı tuz",
  "Alabildiği kadar un",
  "1 bardak susam ezmesi",
  "1 bardak sıvı yağ",
  "4-5 yemek kaşığı şeker (şeker miktarı artırılabilir)"
 ],
 "instructions": [
  "Mayayı, ılık suyun içinde biraz aktif hale getiriyoruz.",
  "Hamur malzemelerini ekleyerek yumuşak bir hamur hazırlıyoruz.",
  "Üzerini örtüp, mayalanmasını bekliyoruz.",
  "Hamur iki katına çıkınca 20 bezeye bölerek yuvarlıyoruz.",
  "Bezeleri pasta tabağı büyüklüğünde açıyoruz. Onarlı iki gruba ayırıyoruz.",
  "Yağ ve susam ezmesi ile hazırladığımız karışımı her yerine gelecek şekilde hamurun üzerine sürüyoruz.",
  "1 tatlı kaşığı kadar şeker serpeliyoruz.",
  "10 tane hamurun üzerlerine aynı işlemi üst üste koyarak tekrarlıyoruz.",
  "Diğer on yufkaya da aynı işlemleri uyguluyoruz.",
  "İlk yaptığımızı elimizle mümkün olduğu kadar çekiştirerek büyütüyoruz, rulo yapıyoruz.",
  "Ruloyu da ellerimizle oklava gibi yuvarlayarak inceltiyoruz.",
  "Tepsiye dolama börek gibi spiral şekilde yuvarlayarak diziyoruz.",
  "İkinci gurup hamura da aynı işlemi uyguluyoruz. Tepsi mayası için bekletiyoruz.",
  "Üzerine fırçayla sıvı yağ sürerek 180 derecede üzeri kızarana kadar pişiriyoruz."
 ],
