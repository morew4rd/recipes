 "ingredients": [
  "10 kg kırmızı kapya biber",
  "10 kg domates",
  "20 yemek kaşığı silme şeker",
  "10 yemek kaşığı tuz",
  "2 bardak sıvı yağ",
  "Karabiber, kimyon ( isteğe bağlı)"
 ],
 "instructions": [
  "Biberleri yıkayıp közlüyoruz.",
  "Domateslerin kabuğunu soyup rondodan geçiriyoruz.",
  "Biberleri de kabuklarını soyup rondodan geçiriyoruz.",
  "İkisini sıvı yağ ile büyük tenceremize alıp karıştırarak suyu çekilene kadar kavuruyoruz.",
  "Kaşıkla sosun ortasına çizgi çiziyoruz.",
  "Çizgi kalırsa olmuş demektir.",
  "Tuzu, şekeri ilave ederek karıştırıyoruz.",
  "Kimyon, karabiber (isteğe bağlı) ilave ediyoruz.",
  "Sıcak sıcak kavanozlara doldurup, havasını alarak ters çevirip örtüyoruz.",
  "Ben çekirdekli sevmediğim için domatesleri doğrayıp kaynamaya koydum,.",
  "Biberleri közleyip ilave ettim.",
  "Domatesler yumuşayınca önce blenderden, sonra da makarna süzgüsünden geçirerek kavurdum.",
  "Kahvaltılarda, yemeklerde, pizza, makarna vs heryerde kullanabileceğimiz nefis sosumuz hazır.",
  "Açtığımız sosumuzu buzdolabında muhafaza ediyoruz."
 ],
