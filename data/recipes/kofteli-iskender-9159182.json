 "ingredients": [
  "Tırnak Pide",
  "600 gram kıyma",
  "1 soğan",
  "1 çay bardağı galeta unu",
  "Tuz, karabiber",
  "Yeşil biber (Kişi başı 2 biber)",
  "Domates (Kişi başı 1 domates)",
  "3-2 kaşık salça",
  "Yarım çay bardağı zeytinyağı",
  "1 kase yoğurt",
  "Yarım bardak tereyağı"
 ],
 "instructions": [
  "Önce köfte hazırlanır. Kıyma, rendelenmiş soğan, 1 çay bardağı galeta unu, tuz ve baharatlarla köfte hazırlanır. Küçük köfteler hazırlanır.",
  "Yarım çay bardağı yağda salça ezilir. Üzerine 2 bardak su ilave edilerek kaynatılır.",
  "Tırnak pideler küçük doğranıp tabaklara paylaştırılır.",
  "Biberler hafif kızartılır. Köfteler pişirilir. Domatesler ikiye bölünerek hafif kızartılır. Pidelerin üzerine salçalı sos dökülür.",
  "Üzerine domates, biber ve köfteler yerleştirilir. En üste iyice kızdırılmış tereyağı dökülür. Kenarına 2-3 kaşık yoğurt konur. Soğutmadan afiyetle yenir. Afiyet olsun 😊."
 ],
