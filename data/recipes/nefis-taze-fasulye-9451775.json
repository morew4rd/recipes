 "ingredients": [
  "1/2 (yarım) kg taze fasülye",
  "2 büyük soğan",
  "2 büyük domates",
  "1 tatlı kaşığı toz kırmızı biber( istenirse pulbiber)",
  "Tuz",
  "1 kesme şeker ya da 1 çay kaşığı toz şeker",
  "1 çay bardağı zeytinyağı"
 ],
 "instructions": [
  "Soğanları küp küp doğrayıp tencerenin dibine yayıyoruz.",
  "Üzerine yıkayıp ayıkladığımız, istediğimiz büyüklükte doğradığımız fasulyeleri yayıyoruz.",
  "Kabuklarını soyup küp küp doğradığımız domatesleri de fasülyelerin üzerine yayıyoruz.",
  "Şekeri, toz kırmızı biberi( istenirse pulbiber de konulabilir) ve tuzu domateslerin üzerine serpeliyoruz.",
  "Üzerine bir çay bardağı yağımızı her yerine gezdirerek kısık ocağa alıyoruz.",
  "Yaklaşık bir saat hiç dokunmuyoruz.",
  "Sonra karıştırıp 15 dakika daha öyle pişiriyoruz.",
  "Domatesler eriyince 1 çay bardağı kadar su ilave ediyoruz.",
  "10 dakika sonra yemeğimiz hazır.",
  "Sarımsaklı cacık veya yoğurtla servis yapabilirsiniz."
 ],
