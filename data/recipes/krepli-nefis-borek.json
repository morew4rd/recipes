  "Hamur İşi Tarifleri",
  "Börek Tarifleri"
 ],
 "servings": "4-6 kişilik",
 "times": {
  "prep": "PT20M",
  "cook": "PT1H30M",
  "total": "PT80M"
 },
 "ingredients": [
  "400 gram kıyma",
  "Yarım çay bardağı zeytinyağı",
  "1 büyük soğan",
  "2-3 adet yeşil biber",
  "1 adet kırmızı kapya biber",
  "1 adet havuç",
  "2 domates rendesi",
  "1 yemek kaşığı domates salçası",
  "Tuz",
  "Karabiber",
  "Toz kırmızı biber",
  "3 adet yumurta",
  "2,5 su bardağı un",
  "2 su bardağı süt",
  "2 su bardağı su",
  "Tuz",
  "Krepleri pişirmek için yarım fincan kadar zeytinyağı",
  "2 yemek kaşığı tereyağı",
  "3 yemek kaşığı un",
  "2,5 su bardağı süt",
  "Tuz",
  "Kaşar rendesi"
 ],
 "instructions": [
  "Önce kıymayı tavaya alıp kavuruyoruz. Kıyma suyunu çekince zeytinyağı ve soğanları ilave ederek 5-6 dakika daha kavuruyoruz.",
  "Havuç ve ince doğranmış biberleri ekleyip, kavuruyoruz.",
  "İyice kavrulunca salçayı ekleyip 1_2 dakika daha kavurarak baharat ve domatesleri ekliyoruz.",
  "4_5 dakika kavurunca bir su bardağı sıcak su ekleyerek kapağı kapalı 7-8 dakika pişiriyoruz.",
  "Krep malzemelerini karıştırıp kreplerimizi hazırlıyoruz.",
  "Krepler pişince borcama krebi alıyoruz üzerine kıymalı harç yayıyoruz.",
  "Malzemeler bitene kadar üst üste krep, üzerine kıymalı harç olarak diziyoruz.",
  "Beşamel sosu hazırlıyoruz. Tavaya un ve tereyağı alıp un kokusu çıkana kadar kavuruyoruz. Sütü ve tuzu ekleyip pişiriyoruz.",
  "Beşamel sosu borcamdaki kreplerin üzerine yayıyoruz.",
  "Üzerine rendelenmiş kaşar serpeliyoruz.",
  "Önceden ısıtılmış 180 derece fırında kontrollü şekilde pişiriyoruz.",
  "İlk sıcaklığı çıktıktan sonra servis ediyoruz."
 ],
