 "ingredients": [
  "2 su bardağı pirinç unu (250 gr)",
  "1,5 su bardağı şeker",
  "150 gram tereyağı",
  "1 çay bardağı rondodan geçirilmiş badem",
  "1 çay bardağı rondodan geçirilmiş ceviz",
  "3 su bardağı sıcak süt"
 ],
 "instructions": [
  "Tereyağını tavaya alıp eritiyoruz pirinç ununu ekliyoruz.",
  "Kaşık ateşte rengi dönene kadar sürekli karıştırıyoruz.",
  "Rengi dönünce ceviz ve bademleri ilave edip birkaç dakika daha kavuruyoruz.",
  "Sonra şekeri ekleyerek bir iki dakika daha kavurup sıcak sütü ilave ederek kavurmaya devam ediyoruz ( bu aşamada ne kadar çok kavrulursa o kadar güzel olur).",
  "Sonra dilediğimiz şekli verip servis ediyoruz. Nefis lezzeti denemenizi tavsiye ediyorum. Afiyet olsun 😊."
 ],
