 "ingredients": [
  "1 litre süt",
  "1 su bardağı (200 mg) şeker",
  "5 yemek kaşığı nişasta",
  "1 adet yumurta sarısı",
  "Kavrulmuş badem (fındık veya ceviz)",
  "İstenirse vanilya",
  "Yarım bardak su",
  "Üzerini yeşil fıstık (veya başka seçeneklerle süsleyebilirsiniz)"
 ],
 "instructions": [
  "Süt ve şeker karıştırılır, kaynatılır.",
  "Kaynama noktasına gelince; su, nişasta ve yumurta sarısı karıştırılır, iyice çırpılır.",
  "Bademleri rondodan geçiriyoruz.",
  "Karışım kaynamakta olan sütlü karışıma yavaş yavaş ilave edilir, karıştırarak pişirilir.",
  "Bademler ilave edilir, pişen keşkül kaselere bölünür.",
  "İstenirse üzeri süslenir, ılınınca dolaba kaldırılır (kaselerin üzerini streçleyip, kaldırıyorum) nefis keşkülümüz servise hazır."
 ],
