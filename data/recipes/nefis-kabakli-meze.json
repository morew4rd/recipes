 "ingredients": [
  "1 kahve fincanı sıvı yağ",
  "2 adet büyük soğan",
  "4 adet kabak",
  "Yarım kg süzme yoğurt",
  "2 yemek kaşığı mayonez",
  "İstediğimiz baharatlar (pulbiber, karabiber olabilir)",
  "2-3 diş sarımsak",
  "Tuz",
  "1 tatlı kaşığı toz kırmızı biber",
  "1 su bardağı kırılmış ceviz içi"
 ],
 "instructions": [
  "Soğanları ince piyazlık doğrayıp kısık ateşte kavuruyoruz.",
  "İyice kavrulan soğanların üzerine yarım ay şeklinde ince doğranmış kabakları ilave ederek kavurmaya devam ediyoruz.(bu aşamada ezilmiş sarımsağı da beraber kavurabiliriz veya yoğurtla karıştırabiliriz).",
  "İyice kavrulunca istediğimiz baharatları( karabiber, pulbiber olabilir) ilave ediyoruz.",
  "Ilınınca süzme yoğurt ve mayonezi karıştırıp ilave ederek karıştırıyoruz.",
  "Servis tabağına alıyoruz.",
  "Üzerine ayrı bir tavada ceviz kavuruyoruz, toz kırmızı biber de ilave ederek ocağı kapatıyoruz.",
  "Servis tabağının üzerine dökerek servis yapıyoruz.Afiyet olsun."
 ],
