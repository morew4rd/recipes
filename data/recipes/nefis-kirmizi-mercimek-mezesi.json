 ],
 "servings": "4-6 kişilik",
 "times": {
  "prep": "PT10M",
  "cook": "PT25M",
  "total": "PT35M"
 },
 "ingredients": [
  "2 su bardağı kırmızı mercimek (bardak ölçüsü 200mg)",
  "4 bardak su",
  "2-3 ince doğranmış soğan",
  "1-2 diş sarımsak",
  "Yarım fincan kadar zeytinyağı",
  "Tuz",
  "Karabiber",
  "Pulbiber",
  "Kimyon",
  "Zerdeçal",
  "1 yemek kaşığı limon suyu",
  "3-4 yemek kaşığı zeytinyağı",
  "1 çay bardağı kadar kırılmış cevizveya çam fıstığı",
  "1 çay kaşığı toz kırmızı biber"
 ],
 "instructions": [
  "Mercimeği iyice yıkayıp tencereye alıyoruz.",
  "Üzerine 2 su bardağı su ilave edip kaynamaya bırakıyoruz.",
  "Kaynayınca ocağı kısıp suyunu çekip yumuşayıncaya kadar arada karıştırarak pişiriyoruz.",
  "Diğer yandan soğanı ince ince doğrayıp zeytinyağında kısık ateşte iyice kavuruyoruz.",
  "Ezilmiş sarımsağı da ilave ederek birkaç dakika kadar daha kavuruyoruz. Ocağı kapatıyoruz.",
  "Tuz ve limon suyu ve baharatları ekleyerek, mercimek ve kavrulmuş soğanı iyice karıştırıyoruz.",
  "Tavaya 3-4 kaşık kadar zeytinyağını alıyoruz. Ceviz veya fıstıkları hafifçe kavuruyoruz.",
  "1 çay kaşığı kırmızı toz biber ilave edip ocağı kapatıyoruz.",
  "Mercimek ezmesini servis tabağına alıp yayıyoruz.",
  "Üzerine kavrulmuş cevizleri ilave ediyoruz maydanoz yapraklarıyla süslüyoruz."
 ],
