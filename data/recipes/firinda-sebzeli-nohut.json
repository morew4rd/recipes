  "prep": "PT20M",
  "cook": "PT50M",
  "total": "PT70M"
 },
 "ingredients": [
  "4 bardak haşlanmış nohut",
  "2 büyük soğan",
  "3-4 yeşil biber",
  "1 büyük kapya biber",
  "3 büyük domates",
  "2-3 diş sarımsak",
  "1 kahve fincanı zeytin yağı",
  "1 yemek kaşığı salça",
  "Tuz",
  "Karabiber",
  "Pulbiber",
  "Kimyon (Sevdiğimiz baharatları ilave edebiliriz)"
 ],
 "instructions": [
  "Önce nohutu haşlıyoruz.",
  "Soğan, domates ve biberleri doğruyoruz.",
  "Soğanları tuz,salça ve baharatlarla harmanlıyoruz.",
  "Fırın kabımızda tüm malzemeleri karıştırıyoruz.",
  "Fırın kağıdını buruşturup ıslatıp suyunu iyice sıkıyoruz.",
  "Tepsinin üzerini fırın kağıdıyla kapatıyoruz.",
  "170 derece önceden ısıtılmış fırında 45-50 dakika suyunu biraz çekeseye kadar pişiriyoruz.",
  "Arada fırın kağıdını kaldırıp yemeği karıştırıyoruz."
 ],
