 "ingredients": [
  "2-3 havuç",
  "2 büyük boy soğan",
  "2 çay bardağı zeytinyağı",
  "Varsa kuyrukyağı",
  "İstenirse kuşbaşı et 200 gr",
  "2,5 bardak pirinç",
  "3 bardak su",
  "Tuz"
