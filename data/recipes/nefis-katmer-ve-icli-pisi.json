 "ingredients": [
  "1 bardak yoğurt",
  "2 bardak su",
  "1 çay kaşığı dolusu yemek sodası",
  "1 yemek kaşığı tuz",
  "Alabildiği kadar un",
  "Pişileri kızartmak için sıvı yağ",
  "Yarım kg lor",
  "Karabiber, pul biber",
  "Veya arzuya göre patates vb"
 ],
 "instructions": [
  "Önce hamuru hazırlayalım.",
  "Unun ortasını açıp yoğurt, su, tuz ve sodayı koyup hamuru yoğuralım.",
  "Kulak memesi kıvamında hazırlanan hamuru bezelere ayıralım.",
  "Bezeleri 1-2mm kadar açalım.",
  "Hamurun uç kısmına fotağraftaki gibi birer kaşık iç malzemeyi sıra sıra koyalım.",
  "Hamuru katlayıp hamur ruleti veya çay bardağıyla kesiyoruz. ( fotoğrafta görebilirsiniz).",
  "Bezelerin bir kısmını da katmer pişi yapalım.",
  "Yufkayı açalım. Üzerine zeytinyağı sürelim. Rulo yapalım.",
  "Ruloları yaklaşık 10 cm kadar bölelim.",
  "Yağlı uçları birleştirelim. Sonra açalım.",
  "Pişilerimizi kızdırdığımız yağda pişirelim.",
  "Gusta markası nefis meze ve kahvaltılıklarla çok yakışıyor."
 ],
