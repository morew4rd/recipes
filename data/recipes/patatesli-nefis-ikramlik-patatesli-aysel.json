 "ingredients": [
  "4-5 adet küp doğranmış patates",
  "2 adet soğan",
  "2-3 adet yeşil biber",
  "1-2 adet kırmızı biber( istenirse)",
  "1 adet (istenirse) rendelenmiş havuç",
  "1 bardak zeytinyağı",
  "1 bardak yoğurt",
  "4-5 bardak un( un bardak sayısı, patates sayısı kadar olacak)",
  "1 adet domates",
  "2 yumurta",
  "1 paket kabartma tozu veya soda",
  "Arzuya göre maydanoz, nane, dereotu",
  "İstenen baharatlar ve tuz",
  "Üzeri için istenirse susam"
 ],
 "instructions": [
  "Malzemeler doğranıp hazırlanır.",
  "Yazıldığı sırayla eklenir.",
  "Derin bir kapta karıştırılır.",
  "Borcam veya fırın tepsisi hafif yağlanır.",
  "Tüm malzeme tepsiye alınıp üzeri düzeltilir.",
  "İstenirse üzeri susamla süslenir.",
  "180 derecede üzeri kızarana kadar pişirilir.",
  "Ilındığında servis yapılır."
 ],
