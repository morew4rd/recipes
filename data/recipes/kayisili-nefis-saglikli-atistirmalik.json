  "prep": "PT35M",
  "cook": "PT5M",
  "total": "PT40M"
 },
 "ingredients": [
  "400 gr kuru kayısı",
  "2 paket petibör bisküvi",
  "200 gram bitter çikolata",
  "1 kutu sıvı krema",
  "2 bardak irice kıyılmış ceviz"
 ],
 "instructions": [
  "Önce kayısıları yarım saat kadar suda bekletiyoruz.",
  "Sonra peçeteye çıkarıp kurumasını bekliyoruz.",
  "Daha sonra küp küp doğruyoruz.",
  "Bisküvileri rondodan geçiriyoruz.",
  "Kremayı uygun bir kaba koyup ocağa alıp ısıtıyoruz.",
  "Kaynama noktasına gelince çikolataları ilave edip ocağı kapatıyoruz.",
  "Çikolata eriyince;İçine cevizleri ve bisküvilerin bir kısmını ilave edip karıştırıyoruz.",
  "Küp doğradığımız kayısıları da ilave edip hamur gibi yoğuruyoruz.",
  "Ceviz büyüklüğünde toplar hazırlayıp kalan bisküviye veya istenirse hindistan cevizine bulayarak saklama kabına alıyoruz.",
  "İstediğimiz zaman keyifle tüketiyoruz.",
  "Üzümlü ve incirli olarakta hazırlanabilir."
 ],
