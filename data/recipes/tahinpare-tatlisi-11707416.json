 "ingredients": [
  "2,5 su bardağı su",
  "2 su bardağı şeker",
  "1 dilim limon ( bardak ölçüsü 200 ml)",
  "125 gram oda sıcaklığında margarin (Veya tereyağ)",
  "1 yumurta",
  "2-3 yemek kaşığı tahin",
  "1-2 yemek kaşığı sirke",
  "Yarım su bardağı çekilmiş ceviz",
  "Yarım su bardağı irmik",
  "1 paket kabartma tozu",
  "1,5 su bardağı un"
 ],
 "instructions": [
  "Önce şerbeti hazırlıyoruz.Su ve şekeri tencereye alıp kaynatıyoruz.",
  "Kaynayan şerbete bir dilim limon atarak 15 dakika kadar kaynatıp soğumaya bırakıyoruz.",
  "Margarin ( veya tereyağı), yumurta,tahin,sirke, ceviz ve kabartma tozunu karıştırıyoruz.",
  "Unu kontrollü bir şekilde ilave ederek yumuşak bir hamur elde ediyoruz.",
  "Ceviz büyüklüğünde parçalar kopararak şekil veriyoruz.",
  "Oval veya yuvarlak şekiller verebiliriz.",
  "Üzerine değişik şekilde süsleyebiliriz.",
  "Tepsiye dizerek, önceden ısıtılmış 180 derece fırında kızarasaya kadar pişiriyoruz.",
  "Tatlımızın ilk sıcaklığının çıkmasının ardından soğuk şerbeti üzerlerine döküyoruz.",
  "Üzerine tepsi kapatıp birkaç saat şerbetini çekmesini bekliyoruz.",
  "İstenirse servis ederken üzerlerini süsleyebiliriz (fıstık, ceviz vs. )"
