 "ingredients": [
  "1.300 gram kuşbaşı et",
  "3-4 adet soğan",
  "1 çay bardağı zeytinyağı",
  "1 kaşık domates salçası",
  "1 kaşık biber salçası",
  "1 tatlı kaşığı toz biber( istenirse pulbiber)",
  "Tuz"
 ],
 "instructions": [
  "Etleri tencereye koyup ocağa alalım.",
  "Suyunu salıp çekene arada karıştıralım.",
  "Soğanları küçük doğrayalım ya da rondodan geçirelim.",
  "Suyunu çeken etlere soğanları ve 1 çay bardağı zeytinyağını ilave edelim.",
  "Soğanlar da kavrulup yumuşayınca salçaları ve tozbiber ekleyerek biraz karıştıralım.",
  "1, 5- 2 bardak kadar sıcak su ilave edip biraz kaynatalım.",
  "Tuzunu da ayarlayalım.",
  "Etler pişince yahnimiz hazır."
 ],
