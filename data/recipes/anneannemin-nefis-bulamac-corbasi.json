  "prep": "PT10M",
  "cook": "PT25M",
  "total": "PT35M"
 },
 "ingredients": [
  "1 su bardağı un (200 mg)",
  "1 su bardağı yoğurt",
  "1 fincan sıvı yağ",
  "1 tatlı kaşığı kırmızı toz biber",
  "Tuz",
  "7 su bardağı su",
  "7-8 taze yeşil soğan",
  "Yarım demet taze nane"
 ],
 "instructions": [
  "Önce taze soğanların yeşil kısımlarını ince ince doğruyoruz.",
  "Taze naneleri de aynı şekilde kıyıyoruz.",
  "1 bardak un, bir bardak yoğurdu çırpıyoruz.",
  "2 bardak su ilave ederek çırpıyoruz.",
  "Tencereye sıvı yağı alarak ocağı açıyoruz.",
  "Kırmızı toz biberi ilave ediyoruz.",
  "Unlu, yoğurtlu karışımı tencereye ilave ederek karıştırıyoruz.",
  "5 bardak suyu da ilave ederek topaklanmaması için sürekli karıştırıyoruz.",
  "Kaynama noktasına gelince (Bu aşamada hafif topaklanma varsa blenderden geçirebiliriz)",
  "Yeşil soğan ve naneleri ilave ediyoruz,.",
  "4-5 dakika kaynadıktan sonra tuzunu ilave ederek ocağı kapatıyoruz.",
  "İlk sıcaklığı geçince servis ediyoruz."
 ],
