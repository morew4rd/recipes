 "servings": "8-10 kişilik",
 "times": {
  "prep": "PT15M",
  "cook": "PT35M",
  "total": "PT50M"
 },
 "ingredients": [
  "1 kg taze incir",
  "1 su bardağı (200 mg) şeker",
  "Yarım limon"
 ],
 "instructions": [
  "Önce incirlerimizi yıkıyoruz.",
  "Sonra kabuklarını soyuyoruz.",
  "Fırın kabına dizerek üzerlerine 1 bardak şekeri döküyoruz.",
  "Üzerini tepsi veya streçfilm ile kapatıyoruz.",
  "1 gece bekletiyoruz.",
  "Ertesi gün 180-190 derece ısıtılmış fırında pişiriyoruz.",
  "Kıvama gelince yarım limon suyunu üzerine gezdirip biraz daha fırında pişirmeye devam ediyoruz.",
  "Benim bu ölçü ile 660 mglık bir kavanoz (tam dolu olmayan) reçelim oldu.",
  "Bu güzel lezzeti denemelisiniz.Afiyet olsun 😊."
 ],
