 "servings": "12-14 kişilik",
 "times": {
  "prep": "PT20M",
  "cook": "PT5M",
  "total": "PT25M"
 },
 "ingredients": [
  "1 paket krema",
  "2 adet bitter çikolata (160gr)",
  "2 paket petibör bisküvi",
  "1 kase kırılmış ceviz",
  "1 kase kuru üzüm"
 ],
 "instructions": [
  "Bisküvileri rondodan geçiriyoruz.",
  "Kremayı ocağa alıyoruz.",
  "Kaynama noktasına gelince çikolataları ilave ediyoruz.",
  "Çikolatalar eriyince ocağı kapatıp kontrollü bir şekilde bisküvileri ilave ederek yumuşak kıvamlı hamur elde ediyoruz.",
  "İçine üzüm ve cevizleri ilave ederek yoğuruyoruz.",
  "Küçük parçalar alıp yuvarlayarak bisküvi kırığına veya hindistan cevizine buluyoruz.",
  "Saklama kabına koyup buzdolabına kaldırıyoruz."
 ],
