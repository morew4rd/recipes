  "Tatlı Tarifleri",
  "Kek Tarifleri"
 ],
 "servings": "10-12 kişilik",
 "times": {
  "prep": "PT15M",
  "cook": "PT30M",
  "total": "PT45M"
 },
 "ingredients": [
  "1 su bardağı şeker",
  "4 adet yumurta",
  "3 yemek kaşığı sıvı yağ",
  "4 yemek kaşığı sıcak su",
  "1 paket kabartma tozu",
  "1 su bardağı un",
  "1 su bardağı nişasta",
  "İstenirse vanilya",
  "1 su bardağı soğuk süt",
  "1 su bardağı tahin",
  "2 yemek kaşığı pudra şekeri",
  "1 su bardağı kıyılmış ceviz içi",
  "1 su bardağı kavrulmuş susam"
 ],
 "instructions": [
  "Önce keki hazırlıyoruz ;Yumurta ve şeker köpük köpük olana kadar çırpıyoruz.",
  "Sıvıyağ ve sıcak su ekleyerek çırpmaya devam ediyoruz.",
  "Un, nişasta ve kabartma tozunu eleyerek karıştırıyoruz.",
  "Yağlanmış kare borcama dökerek önceden ısıtılmış fırında alt üst ayarda kontrollü olarak üzeri kızarıncaya kadar( kürdan testi yapılabilir)pişiriyoruz.",
  "Keki fırından çıkarıp ilk sıcaklığının geçmesi için birkaç dakika bekletiyoruz.",
  "Üzerine çatalla veya kürdanla delikler açarak soğuk sütü her yerine eşit döküyoruz.",
  "1 su bardağı tahin ve 2 yemek kaşığı pudra şekerini karıştırarak kekin üzerine gezdiriyoruz.",
  "Kavurduğumuz susam ve cevizleri üzerine serpiyoruz.",
  "Nefis kekimiz soğuyunca istediğimiz şekilde kesip servis ediyoruz.Afiyet olsun 😊."
 ],
