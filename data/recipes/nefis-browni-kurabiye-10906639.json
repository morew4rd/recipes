 "ingredients": [
  "1 su bardağı şeker",
  "2 yumurta",
  "1 çay bardağı zeytinyağı",
  "1 su bardağı damla çikolata (Ben 120 gram kadar çikolatayı keserek kullandım)",
  "200 gr nişasta (1 paket)",
  "1 su bardağı un",
  "3 yemek kaşığı kakao",
  "1 paket kabartma tozu",
  "İstenirse vanilya"
 ],
 "instructions": [
  "Önce karıştırma kabına yumurta, şeker ve sıvı yağı ekliyoruz.",
  "Şeker eriyinceye kadar çırpıyoruz.",
  "Un, kakao,nişasta ve kabartma tozunu eleyerek kurabiye hamurunu yoğuruyoruz.",
  "Çikolata parçalarını da ekleyerek biraz daha yoğuruyoruz.",
  "Biraz ele yapışan bir hamur oluyor, un eklemiyoruz.",
  "1-2 saat kadar buzdolabında bekletiyoruz.",
  "Sonra eşit bölmeye çalışarak yuvarlıyoruz.",
  "Biraz yassıltıp yağlı kağıt serilmiş tepsiye diziyoruz.",
  "Önceden ısıtılmış 180 derece fırında 10 dakika pişirip fırından çıkarıp soğumaya bırakıyoruz.",
  "Fırından çıkan kurabiyeler yumuşak olacaktır.",
  "En az yarım saat kadar soğumasını bekliyoruz kurabiyenin dış yüzeyi sertleşecek, içi browni gibi yumuşacık olacaktır.",
  "Soğuyunca servis yapabilirsiniz."
 ],
