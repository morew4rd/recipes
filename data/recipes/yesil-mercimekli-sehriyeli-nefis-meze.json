 "ingredients": [
  "2,5 su bardağı (200m g) haşlanmış arpa şehriye",
  "1,5 su bardağı haşlanmış yeşil mercimek",
  "750 gr yoğurt",
  "10-12 tane kornişon turşu",
  "2-3 diş sarımsak",
  "Yarım demet maydanoz",
  "1,5 bardak kadar haşlanmış darı ( ben konserve kullandım)",
  "Yarım tatlı kaşığı karabiber",
  "Pulbiber",
  "Tuz",
  "İsteğe bağlı 2 kaşık mayonez",
  "1 limonun suyu",
  "2 kaşık zeytinyağı",
  "Yarım kahve fincanı zeytinyağı",
  "1 tatlı kaşığı kırmızı toz biber"
 ],
 "instructions": [
  "Arpa şehriye ve mercimeği haşlıyoruz.",
  "Haşlanan mercimek ve arpa şehriyeyi süzüyoruz.",
  "Arpa şehriyeyi soğuk sudan geçirip 2 -3 kaşık yağ ile karıştırıyoruz.",
  "Büyükçe bir kaba; mercimek, arpa şehriye, darı, küçük doğradığımız maydanoz ve kornişonları ilave ediyoruz.",
  "Karabiber, pulbiber ve tuz ilave ediyoruz.Hepsini harmanlıyoruz.",
  "Sarımsağı tuzla eziyoruz.Yoğurtla karıştırıyoruz.",
  "1 limonun suyunu da ilave ederek (istenirse 2-3 kaşık mayonez ilave ediyoruz) malzemeleri karıştırıyoruz.",
  "Servis tabağına alıp.Üzerine yağ hazırlıyoruz.",
  "Zeytinyağın ısıtıp, kırmızı toz biberi ilave edip ocaktan alıyoruz.",
  "Mezemizin üzerine yağlı karışımı kaşıkla gezdiriyoruz."
 ],
