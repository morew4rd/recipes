  "prep": "PT10M",
  "cook": "",
  "total": "PT10M"
 },
 "ingredients": [
  "1 çay bardağından 2-3 cm eksik şeker",
  "1 paket kremşanti",
  "1 su bardağı soğuk süt (200ml)",
  "1 adet yumurta",
  "2 yemek kaşığı kakao",
  "1 çay bardağı kadar damla çikolata"
 ],
 "instructions": [
  "Yumurta ve şekeri 4-5 dakika mikserle çırpıyoruz.",
  "Süt ve kremşantiyi kıvam alıncaya kadar mikserle çırpıyoruz.",
  "Yumurta ve şeker karışımını kremşantili karışıma ilave edip iyice karıştırıyoruz.",
  "Saklama kabına koyarak buzluğa kaldırıyoruz. 5-6 saat sonra ister külahta, isterseniz kasede ikram ediyoruz.",
  "Kakaolu yapmak istersek; yumurta ve şekeri çırpıyoruz. Süt ve kremşantiyi çırparken 2 kaşık kadar kakao ekliyoruz. Sonunda çikolata parçaları ilave ederek saklama kabına koyarak buzluğa kaldırıyoruz."
 ],
