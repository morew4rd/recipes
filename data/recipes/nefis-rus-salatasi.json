 "ingredients": [
  "2 adet havuç",
  "2 adet patates",
  "4 adet haşlanmış yumurta",
  "1,5 su bardağı kadar bezelye",
  "3-4 adet salatalık turşusu",
  "Yarım demet dereotu",
  "5-6 kaşık tepeleme mayonez",
  "Çay kaşığının ucuyla köri ve karabiber"
 ],
 "instructions": [
  "Bezelyeleri haşlıyoruz.",
  "Havuç, patates ve yumurtaları da haşlıyoruz.",
  "Havuç ve patateslerin kabuklarını soyup küçük küpler halinde doğruyoruz.",
  "Bezelyelerin suyunu süzüyoruz.",
  "Yumurtaların kabuklarını soyuyoruz.",
  "Dört yumurtanın beyazını, iki yumurtanın sarısını doğruyoruz.",
  "Tüm malzemeleri, baharat ve tuzu karıştırarak birkaç saat dolapta dinlendiriyoruz. Nefis salatamızı yemeklerde, günlerde afiyetle yiyoruz. Afiyet olsun 😊."
