 "ingredients": [
  "1 tavuk göğüs eti",
  "2 parça incik",
  "2 kaşık un",
  "1 diş sarımsak",
  "2 kaşık zeytinyağı",
  "Yarım kaşık tereyağı",
  "1 çay kaşığı kuru nane",
  "Yarım çay kaşığına yakın karabiber",
  "Tuz"
 ],
 "instructions": [
  "Tereyağı ve zeytinyağı karışımını ocağa alıyoruz.",
  "İnce doğranmış sarımsağı kısık ateşte kavuruyoruz.",
  "Unu da ekleyip kokusu gidene kadar birkaç dakika kavuruyoruz.",
  "Tavuk suyu ilave ederek kaynayasıya kadar karıştırıyoruz.",
  "Kaynayınca önceden tifttiğimiz tavuk etlerini ilave ediyoruz.",
  "Limonunu ve baharatları da ilave ediyoruz.",
  "En son tuzunu ve kıvamını ayarlayıp ocağı kapatıyoruz. Sağlıklı, nefis çorbamız hazır. Afiyet olsun 😊."
