 "ingredients": [
  "5-6 adet patlıcan",
  "500 gram kıyma",
  "2-3 adet soğan",
  "1 kaşık domates salçası",
  "1 kaşık biber salçası",
  "Tuz",
  "Karabiber",
  "Pulbiber",
  "Zeytinyağı",
  "2-3 adet biber",
  "1 adet domates"
 ],
 "instructions": [
  "Patlıcanları yıkayıp soyuyoruz.",
  "Tuzlu suda biraz bekletiyoruz.",
  "Soğanları rondodan geçirip kavurmaya başlıyoruz.",
  "Kavrulan soğanların üzerine kıymayı ilave ederek kavurmaya devam ediyoruz.",
  "İyice kavrulunca salçaları, baharatları ve tuzu ilave edip bir bardak kadar su koyup kaynatıyoruz.",
  "Patlıcanları doğrayıp fırın tepsisine alıyoruz.",
  "Biraz tuz ve zeytinyağı ile harmanlayıp 200 derecede kızartıyoruz.",
  "Borcamın altına kızarmış patlıcanları diziyoruz.",
  "Üzerine kıymalı harçtan yayıyoruz.",
  "Kalan patlıcanları da üzerine dizerek kıymalı harcın tamamını üzerine koyup düzeltiyoruz.",
  "Suyu az gelirse az su kaynatıp üzerine gezdiriyoruz.",
  "Domates ve biberle süsleyerek 200 derecede üzerindeki biberler biraz kızarasaya kadar fırınlıyoruz."
 ],
