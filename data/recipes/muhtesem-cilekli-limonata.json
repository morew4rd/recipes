  "prep": "PT15M",
  "cook": "",
  "total": "PT15M"
 },
 "ingredients": [
  "3-4 limon",
  "1 portakal",
  "1 çay kaşığı limon tuzu",
  "3 bardak şeker (Azaltıp- arttırabilirsiniz)",
  "400- 500 gram rondodan çekilmiş çilek"
 ],
 "instructions": [
  "Limon ve portakalın kabuklarını rendeliyoruz veya soyucuyla ince soyuyoruz.",
  "Yarım bardak şekerle biraz ovalayarak aromasının çıkmasını sağlıyoruz.",
  "Limon ve portakalın kabuğunu altındaki beyaz olan kısmı soyup atıyoruz.",
  "Doğrayarak poşete koyarak dondurucuya koyuyoruz.",
  "Dolaptan çıkarıp, bir süre bekletiyoruz.",
  "Daha sonra biraz şeker ve su ilavesiyle rondodan geçiriyoruz.",
  "Süzgeçten geçiriyoruz.",
  "Birkaç tur biraz su ilavesiyle rondodan geçirip, süzüyoruz.",
  "Çilekleri rondodan geçiriyoruz.",
  "Ben çilekleri de süzgüden geçirerek limonataya ilave ettim.",
  "Suyunu ve şekerini ayarlayarak kavanozlara doldurup dolaba kaldırıyoruz. Nefis, mis kokulu limonatamız hazır. Afiyet olsun 😊."
 ],
