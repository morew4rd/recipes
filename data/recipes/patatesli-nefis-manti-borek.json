 "ingredients": [
  "7-8 büyük boy haşlanmış patates",
  "Tuz, karabiber, pulbiber",
  "Yarım çay bardağı zeytinyağı",
  "Un, 2, 5 bardak su, tuz",
  "1 kase zeytin yağı"
 ],
 "instructions": [
  "Önce patatesleri haşlıyoruz.",
  "Haşlanan patatesleri rendeleyerek ya da çatalla veya patates ezeceğiyle eziyoruz.",
  "İçine tuz, karabiber, pulbiber, sıvı yağ ilave ediyoruz.",
  "İç malzememizi göz kararı dört parçaya bölüyoruz.",
  "Hamuru hazırlıyoruz;2, 5 bardak su, 1 yemek kaşığı tuz ile börek hamurunu hazırlıyoruz.",
  "Hamurumuzu 40 bezeye bölüyoruz.",
  "Tabak büyüklüğünde açıyoruz.",
  "10 lu guruplar olarak 4 gurup olarak hazırlıyoruz.",
  "Aralarına bir yemek kaşığı kadar yağ sürerek 4 adet 10 lu hamurumuzu hazır ediyoruz.",
  "Hamurlarımızı biraz elle çekiştirerek, biraz da oklava yardımıyla büyütüyoruz.",
  "Hamuru kare gibi yapmaya çalışıyoruz.",
  "4 eşit parçaya bölüyoruz.",
  "Patatesli harcın 1/4 ünü paylaştırıyoruz.",
  "Fırın kağıdı serilmiş tepsimize yerleştiriyoruz.",
  "Diğer hamurlara da aynı işlemi uyguluyoruz.",
  "İstediğimiz büyüklükte kesip böreğimizin üzerini yağlıyoruz.",
  "200 derecede üzeri kızarasıya kadar pişiriyoruz.Nefis böreğimiz hazır,.Afiyet olsun 😊."
 ],
